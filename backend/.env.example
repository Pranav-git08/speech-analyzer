# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=speech_analyzer
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=recordings

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid (Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@speechanalyzer.com

# Speech-to-Text
STT_PROVIDER=whisper
STT_API_KEY=

# AI Agent (Groq preferred, OpenAI fallback)
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=llama-3.3-70b-versatile

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
